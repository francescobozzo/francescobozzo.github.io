---
// Floating button that appears once the page is scrolled down.
---

<button id="back-to-top" type="button" aria-label="Back to top" title="Back to top" hidden>
  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <polyline points="18 15 12 9 6 15" />
  </svg>
</button>

<script is:inline>
  {
    const button = document.getElementById('back-to-top');
    const update = () => (button.hidden = scrollY < 300);

    // Smooth only here: a global `scroll-behavior: smooth` would also
    // animate the browser's scroll restoration on reload.
    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
    button.addEventListener('click', () =>
      scrollTo({ top: 0, behavior: reduceMotion.matches ? 'instant' : 'smooth' }),
    );
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  #back-to-top {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    z-index: 100;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-text-secondary);
    cursor: pointer;
  }

  #back-to-top:hover {
    color: var(--color-text);
    border-color: var(--color-text);
  }
</style>
