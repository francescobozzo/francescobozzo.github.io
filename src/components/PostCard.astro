---
import type { CollectionEntry } from 'astro:content';
import { formatDate, readingTime } from '../lib/posts';
import Tags from './Tags.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, pubDate, tags } = post.data;
---

<article class="post-card">
  <div class="post-aside eyebrow">
    <time datetime={pubDate.toISOString()}>{formatDate(pubDate, 'short')}</time>
    <span>{readingTime(post.body)} min read</span>
  </div>
  <div>
    <h2 class="post-title">
      <a href={`/blog/${post.id}/`}>{title}</a>
    </h2>
    <p class="post-excerpt">{description}</p>
    {tags.length > 0 && (
      <div class="post-tags">
        <Tags tags={tags} link />
      </div>
    )}
  </div>
</article>

<style>
  /* Date column on the left, content on the right; one hairline per row */
  .post-card {
    position: relative;
    display: grid;
    grid-template-columns: 7.5rem 1fr;
    gap: 0.5rem 1.5rem;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-aside {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 0.55rem;
  }

  .post-title {
    font-size: clamp(1.45rem, 1.3rem + 0.8vw, 1.8rem);
    margin: 0;
  }

  /* Stretched link: the title link covers the whole row. Tag links sit
     above it via z-index. */
  .post-title a {
    color: var(--color-text);
    transition: color 0.15s;
  }

  .post-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .post-card:hover .post-title a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-excerpt {
    color: var(--color-text-secondary);
    font-size: 0.95em;
    line-height: 1.55;
    margin: 0.6em 0 0;
    text-wrap: pretty;
  }

  .post-tags {
    position: relative;
    z-index: 1;
    width: fit-content;
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .post-card {
      grid-template-columns: 1fr;
      padding-block: 1.75rem;
    }

    .post-aside {
      flex-direction: row;
      gap: 1em;
      padding-top: 0;
    }
  }
</style>
