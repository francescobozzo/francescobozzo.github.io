---
/**
 * Filters the post cards already on the page (title, date, tags, excerpt).
 * No index to fetch: the page is the index.
 */
---

<input
  type="search"
  id="search-input"
  class="search-input"
  placeholder="Search posts..."
  aria-label="Search posts"
  autocomplete="off"
/>
<p id="search-empty" class="empty-state" role="status" hidden>No results found.</p>

<script is:inline>
  document.getElementById('search-input').addEventListener('input', (event) => {
    const query = event.target.value.trim().toLowerCase();
    let matches = 0;
    for (const card of document.querySelectorAll('.post-card')) {
      card.hidden = !card.textContent.toLowerCase().includes(query);
      if (!card.hidden) matches++;
    }
    document.getElementById('search-empty').hidden = matches > 0;
  });
</script>

<style>
  .search-input {
    width: 100%;
    margin-bottom: 2rem;
    padding: 0.6em 0.9em;
    font-family: var(--font-sans);
    font-size: 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-bg);
    color: var(--color-text);
  }

  .search-input::placeholder {
    color: var(--color-text-muted);
  }
</style>
