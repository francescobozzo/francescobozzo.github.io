---
import type { CollectionEntry } from 'astro:content';
import Tags from './Tags.astro';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, description, tags, demoUrl, repoUrl, imageUrl } = project.data;
---

<article class="project-card">
  <h2 class="project-title">
    <a href={`/projects/${project.id}/`}>{title}</a>
  </h2>
  <p class="project-description">{description}</p>
  {imageUrl && <img class="project-image" src={imageUrl} alt="" loading="lazy" />}
  <div class="project-foot">
    <Tags tags={tags} />
    <div class="project-links eyebrow">
      {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source &nearr;</a>}
      {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer">Demo &nearr;</a>}
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    padding-block: 2.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .project-title {
    font-size: clamp(1.45rem, 1.3rem + 0.8vw, 1.8rem);
    margin: 0;
  }

  /* Stretched link: the title link covers the whole row. The external
     links sit above it via z-index. */
  .project-title a {
    color: var(--color-text);
    transition: color 0.15s;
  }

  .project-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .project-card:hover .project-title a {
    color: var(--color-accent);
    text-decoration: none;
  }

  .project-description {
    color: var(--color-text-secondary);
    font-size: 0.95em;
    line-height: 1.55;
    margin: 0.6em 0 0;
    text-wrap: pretty;
  }

  .project-image {
    width: 100%;
    max-height: 14rem;
    object-fit: cover;
    margin-top: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  /* Tags on the left, plain text links (source, demo) on the right */
  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .project-links {
    position: relative;
    z-index: 1;
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .project-links a {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .project-card {
      padding-block: 1.75rem;
    }
  }
</style>
