---
interface Props {
  diagram: string;
}

const { diagram } = Astro.props;
---

<div class="mermaid-wrapper">
  <div class="mermaid">
    <pre class="mermaid-source" hidden>{diagram}</pre>
  </div>
</div>

<style>
  .mermaid-wrapper {
    margin: 1.5em 0;
    text-align: center;
    background: var(--color-bg-secondary, #f8f9fa);
    border: 1px solid var(--color-border, #d0d7de);
    border-radius: 8px;
    padding: 0.75rem 1rem;
    overflow-x: auto;
  }

  .mermaid {
    line-height: 0;
  }

  .mermaid svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .mermaid-error {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: left;
    padding: 0.5rem;
    margin: 0;
    white-space: pre;
  }
</style>

<script>
// Lazy-load mermaid only when a diagram element exists on the page.
// This avoids bundling the entire mermaid library (600+KB) for pages
// that don't use mermaid diagrams.
let mermaidInstance: any = null;

function getTheme() {
  return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'default';
}

async function loadMermaid() {
  if (mermaidInstance) return mermaidInstance;
  const mermaid = await import('mermaid');
  mermaidInstance = mermaid;
  mermaid.default.initialize({
    startOnLoad: false,
    theme: getTheme(),
    securityLevel: 'strict',
    // Respect user's motion preference
    ...(window.matchMedia('(prefers-reduced-motion: reduce)').matches
      ? { sequence: false }
      : {}),
  });
  return mermaid;
}

async function renderAll() {
  // Only load mermaid if there are diagram elements to render
  const elements = document.querySelectorAll('.mermaid');
  if (elements.length === 0) return;

  const mermaid = await loadMermaid();

  elements.forEach((el) => {
    const source = el.querySelector('.mermaid-source');
    if (!source) return;
    const diagram = source.textContent || '';
    if (!diagram.trim()) return;

    // Clear previous content (SVG or error)
    el.innerHTML = '';

    const id = `mermaid-${Math.random().toString(36).slice(2, 10)}`;
    mermaid.default.render(id, diagram).then((result: any) => {
      el.innerHTML = result.svg;
    }).catch((err: any) => {
      console.error('Mermaid render error:', err);
      el.innerHTML = `<pre class="mermaid-error">${diagram}</pre>`;
    });
  });
}

renderAll();

// Re-render on theme change and after client-side navigation
document.addEventListener('astro:after-swap', () => {
  // Reset cached instance so theme re-initializes
  mermaidInstance = null;
  renderAll();
});
</script>
