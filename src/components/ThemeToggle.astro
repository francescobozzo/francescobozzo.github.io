---
/**
 * Cycles <html data-theme> through auto -> light -> dark and saves it in
 * localStorage.theme. The CSS does the rest: `color-scheme` picks the colors
 * and the attribute picks the icon. BaseLayout applies the saved value
 * before first paint.
 */
---

<button class="theme-toggle" type="button" aria-label="Theme: auto" title="Theme: auto">
  <svg class="icon-auto" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect width="18" height="14" x="3" y="3" rx="2" />
    <line x1="12" y1="3" x2="12" y2="21" />
    <path d="M8 21h8" />
  </svg>
  <svg class="icon-light" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5" />
    <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42" />
  </svg>
  <svg class="icon-dark" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
  </svg>
</button>

<script is:inline>
  {
    const root = document.documentElement;
    const button = document.querySelector('.theme-toggle');
    const modes = ['auto', 'light', 'dark'];
    const label = () => (button.title = button.ariaLabel = `Theme: ${root.dataset.theme}`);

    label();
    button.addEventListener('click', () => {
      root.dataset.theme = modes[(modes.indexOf(root.dataset.theme) + 1) % 3];
      label();
      try { localStorage.theme = root.dataset.theme; } catch {}
    });
  }
</script>

<style>
  .theme-toggle {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: none;
    border-radius: 6px;
    background: var(--color-toggle-bg);
    color: var(--color-text);
    cursor: pointer;
  }

  .theme-toggle:hover {
    background: var(--color-border);
  }

  /* Show only the icon matching <html data-theme> */
  .icon-light,
  .icon-dark,
  :global([data-theme='light']) .icon-auto,
  :global([data-theme='dark']) .icon-auto {
    display: none;
  }

  :global([data-theme='light']) .icon-light,
  :global([data-theme='dark']) .icon-dark {
    display: block;
  }
</style>
