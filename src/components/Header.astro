---
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;

// The site title links home, so "Home" needs no entry of its own.
const navLinks = [
  { href: '/about/', label: 'About' },
  { href: '/blog/', label: 'Blog' },
  { href: '/projects/', label: 'Projects' },
];
---

<header class="site-header">
  <div class="header-inner wrap">
    <a href="/" class="site-title">Francesco Bozzo</a>
    <nav class="nav-links" aria-label="Main">
      {navLinks.map(({ href, label }) => (
        <a
          href={href}
          class="nav-link"
          aria-current={path === href ? 'page' : path.startsWith(href) ? 'true' : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-height);
    background: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
  }

  .header-inner {
    height: 100%;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-title {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--color-text);
    /* On very narrow screens the title gives way before the nav does */
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-links {
    display: flex;
    margin-left: auto;
  }

  .nav-link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    padding: 0.5em 0.65em;
    white-space: nowrap;
  }

  .site-title:hover,
  .nav-link:hover,
  .nav-link[aria-current] {
    color: var(--color-text);
    text-decoration: none;
  }

  @media (max-width: 640px) {
    .header-inner {
      gap: 0.125rem;
    }

    .site-title {
      font-size: 1.15rem;
    }

    .nav-link {
      padding: 0.6em 0.4em;
    }
  }
</style>
