---
interface Props {
  tags: string[];
  /** Render tags as links to /blog/tag/{tag}/ */
  link?: boolean;
}

const { tags, link = false } = Astro.props;
---

<div class="tags">
  {tags.map((tag) =>
    link ? <a href={`/blog/tag/${tag}/`} class="tag">{tag}</a> : <span class="tag">{tag}</span>,
  )}
</div>

<style>
  .tags {
    display: flex;
    gap: 0.4rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.6875rem;
    line-height: 1.5;
    padding: 0.1em 0.7em;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-text-secondary);
    white-space: nowrap;
  }

  a.tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    text-decoration: none;
  }
</style>
