---
interface Props {
  tags: string[];
  /** Render tags as links to /blog/tag/{tag}/ */
  link?: boolean;
}

const { tags, link = false } = Astro.props;
---

<div class="tags">
  {tags.map((tag) =>
    link ? <a href={`/blog/tag/${tag}/`} class="tag">{tag}</a> : <span class="tag">{tag}</span>,
  )}
</div>

<style>
  .tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.1em 0.5em;
    border-radius: 999px;
    background: var(--color-tag-bg);
    color: var(--color-accent);
    white-space: nowrap;
  }

  a.tag:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    text-decoration: none;
  }
</style>
