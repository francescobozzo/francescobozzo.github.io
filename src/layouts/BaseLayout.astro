---
import '../styles/global.css';
import katexCss from 'katex/dist/katex.min.css?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title: string;
  description?: string;
  /** Absolute URL or root-relative path used for og:image / twitter:image */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** Load the KaTeX stylesheet (only pages that actually render math) */
  math?: boolean;
}

const {
  title,
  description = 'Personal website of Francesco Bozzo',
  ogImage,
  ogType = 'website',
  math = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage && new URL(ogImage, Astro.site);
---

<!doctype html>
<html lang="en" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- Apply the saved theme before first paint -->
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.theme || 'auto'; } catch {}
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Francesco Bozzo" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="preload" href="/fonts/source-serif-4-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Francesco Bozzo - Blog RSS" href="/rss.xml" />

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="Francesco Bozzo" />
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}

    {math && <link rel="stylesheet" href={katexCss} />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content" class="wrap">
      <slot />
    </main>
    <Footer />
    <BackToTop />
  </body>
</html>
