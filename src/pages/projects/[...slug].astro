---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { title, description, tags, repoUrl, demoUrl, imageUrl } = project.data;
const { Content } = await render(project);
---

<BaseLayout
  title={`${title} - Francesco Bozzo`}
  description={description}
  ogImage={imageUrl}
  ogType="article"
  math={project.body?.includes('$')}
>
  <article>
    <header class="page-header project-header">
      <p class="eyebrow"><a href="/projects/">Projects</a></p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="project-meta">
        <Tags tags={tags} />
        <div class="project-links eyebrow">
          {repoUrl && <a href={repoUrl} target="_blank" rel="noopener noreferrer">Source &nearr;</a>}
          {demoUrl && <a href={demoUrl} target="_blank" rel="noopener noreferrer">Demo &nearr;</a>}
        </div>
      </div>
    </header>

    {imageUrl && <img class="project-image" src={imageUrl} alt="" />}

    <div class="prose">
      <Content />
    </div>

    <nav class="project-nav">
      <a href="/projects/" class="more-link">&larr; All projects</a>
    </nav>
  </article>
</BaseLayout>

<style>
  .project-header {
    margin-bottom: 2.5rem;
  }

  .project-header h1 {
    font-size: clamp(2rem, 1.5rem + 2.6vw, 3.1rem);
  }

  .eyebrow a {
    color: inherit;
  }

  .project-image {
    width: 100%;
    margin-bottom: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 6px;
  }

  .project-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    margin-top: 1.5rem;
  }

  .project-links {
    display: flex;
    gap: 1.25rem;
    margin-left: auto;
  }

  .project-links a {
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .project-links a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .project-nav {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }
</style>
