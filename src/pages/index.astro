---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/posts';

const posts = (await getPosts()).slice(0, 3);
---

<BaseLayout title="Francesco Bozzo" description="Personal website of Francesco Bozzo">
  <section class="hero">
    <h1>Francesco Bozzo</h1>
    <p class="lede">
      Software engineer at Amazon. Nix, self-hosting, reverse engineering.
    </p>
    <p class="hero-links">
      <a href="/about/" class="button-link">About</a>
      <a href="/projects/" class="more-link">Projects &rarr;</a>
    </p>
  </section>

  {posts.length > 0 && (
    <section class="latest-posts">
      <div class="section-head">
        <h2 class="eyebrow">Latest posts</h2>
        <a href="/blog/" class="more-link">All posts &rarr;</a>
      </div>
      {posts.map((post) => <PostCard post={post} />)}
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-bottom: 1rem;
  }

  .hero h1 {
    font-size: clamp(2.75rem, 1.8rem + 5vw, 4.5rem);
    line-height: 1.02;
    letter-spacing: -0.025em;
    font-weight: 340;
    margin-bottom: 0;
  }

  .hero-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    margin: 2rem 0 0;
  }

  .latest-posts {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .section-head h2 {
    margin: 0;
    font-weight: 400;
    line-height: inherit;
  }
</style>
