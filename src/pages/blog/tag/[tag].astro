---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import { getPosts } from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  const tags = [...new Set(posts.flatMap((post) => post.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`Tag: ${tag} - Francesco Bozzo`} description={`Blog posts tagged with "${tag}"`}>
  <header class="page-header">
    <p class="eyebrow"><a href="/blog/">Blog</a> / Tag</p>
    <h1>{tag}</h1>
    <p class="meta">{posts.length} {posts.length === 1 ? 'post' : 'posts'}</p>
  </header>

  {posts.map((post) => <PostCard post={post} />)}
</BaseLayout>

<style>
  .eyebrow a {
    color: inherit;
  }

  .meta {
    margin: 1.5rem 0 0;
  }
</style>
