---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Tags from '../../components/Tags.astro';
import { formatDate, getPosts, readingTime } from '../../lib/posts';

interface Props {
  post: CollectionEntry<'blog'>;
  newer?: CollectionEntry<'blog'>;
  older?: CollectionEntry<'blog'>;
}

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

const { post, newer, older } = Astro.props;
const { title, description, pubDate, updatedDate, tags, heroImage } = post.data;
const { Content } = await render(post);

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Francesco Bozzo' },
  keywords: tags,
});
---

<BaseLayout
  title={`${title} - Francesco Bozzo`}
  description={description}
  ogImage={heroImage?.url}
  ogType="article"
  math={post.body?.includes('$')}
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <div class="reading-progress" aria-hidden="true"></div>

  <article>
    <header class="post-header">
      <h1>{title}</h1>
      <div class="meta">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        <span>&middot;</span>
        <span>{readingTime(post.body)} min read</span>
        {tags.length > 0 && (
          <>
            <span>&middot;</span>
            <Tags tags={tags} link />
          </>
        )}
      </div>
    </header>

    {heroImage && <img class="hero-image" src={heroImage.url} alt={heroImage.alt} />}

    <div class="prose">
      <Content />
    </div>

    {updatedDate && <p class="updated-notice">Updated {formatDate(updatedDate)}</p>}

    {(older || newer) && (
      <nav class="post-nav" aria-label="Posts">
        {older && (
          <a href={`/blog/${older.id}/`} class="post-nav-link older">
            <span class="direction">&larr; Older</span>
            {older.data.title}
          </a>
        )}
        {newer && (
          <a href={`/blog/${newer.id}/`} class="post-nav-link newer">
            <span class="direction">Newer &rarr;</span>
            {newer.data.title}
          </a>
        )}
      </nav>
    )}
  </article>
</BaseLayout>

<style>
  /* Reading progress bar: pure CSS, driven by the page scroll position.
     Browsers without scroll-driven animations simply don't show it. */
  @supports (animation-timeline: scroll()) {
    .reading-progress {
      position: fixed;
      inset: 0 0 auto;
      z-index: 200;
      height: 3px;
      background: var(--color-accent);
      transform-origin: left;
      /* Longhands on purpose: the CSS minifier folds animation-timeline
         into the `animation` shorthand, which browsers then reject. */
      animation-name: reading-progress;
      animation-timing-function: linear;
      animation-fill-mode: both;
      animation-timeline: scroll(root);
    }

    @keyframes reading-progress {
      from { transform: scaleX(0); }
      to { transform: scaleX(1); }
    }
  }

  .post-header {
    margin-bottom: 2rem;
  }

  .post-header h1 {
    margin-bottom: 0.5em;
  }

  .hero-image {
    width: 100%;
    margin-bottom: 2rem;
    border-radius: 8px;
  }

  .updated-notice {
    font-family: var(--font-sans);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-style: italic;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .post-nav-link {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
  }

  .post-nav-link:hover {
    border-color: var(--color-accent);
    text-decoration: none;
  }

  /* Older always sits left, newer always right, even when only one exists */
  .newer {
    grid-column: 2;
    text-align: right;
  }

  .direction {
    display: block;
    margin-bottom: 0.2em;
    font-size: 0.75rem;
    font-weight: 400;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
</style>
